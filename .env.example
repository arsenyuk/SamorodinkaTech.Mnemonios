# =============================================================================
# Mnemonios - Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values
# NEVER commit .env to version control!

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:5000

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# -----------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=mnemonios
POSTGRES_USER=mnemonios
POSTGRES_PASSWORD=your_secure_password_here

# Connection string (auto-generated from above)
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password_here
REDIS_DEFAULT_DATABASE=0

# Connection string
REDIS_URL=redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}/${REDIS_DEFAULT_DATABASE}

# -----------------------------------------------------------------------------
# RabbitMQ
# -----------------------------------------------------------------------------
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=mnemonios
RABBITMQ_PASSWORD=your_rabbitmq_password_here
RABBITMQ_VHOST=/

# Connection string
RABBITMQ_URL=amqp://${RABBITMQ_USER}:${RABBITMQ_PASSWORD}@${RABBITMQ_HOST}:${RABBITMQ_PORT}/${RABBITMQ_VHOST}

# -----------------------------------------------------------------------------
# Authentication
# -----------------------------------------------------------------------------
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long
JWT_ISSUER=Mnemonios
JWT_AUDIENCE=Mnemonios
JWT_EXPIRY_MINUTES=60

# API Keys
API_KEY=your_api_key_here
API_SECRET=your_api_secret_here

# HMAC Key (for identification key generation in ЕДИН MPI)
HMAC_KEY=your_hmac_secret_key_at_least_32_characters_long

# -----------------------------------------------------------------------------
# Storage (MinIO / S3-compatible)
# -----------------------------------------------------------------------------
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=mnemonios
MINIO_USE_SSL=false

# -----------------------------------------------------------------------------
# External Services
# -----------------------------------------------------------------------------
# Add your external service integrations here

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
LOG_LEVEL=Information
LOG_FORMAT=json

# Sentry (error tracking)
SENTRY_DSN=your_sentry_dsn
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=1.0

# -----------------------------------------------------------------------------
# Feature Flags
# -----------------------------------------------------------------------------
FEATURE_BETA_FEATURES=false

# -----------------------------------------------------------------------------
# Rate Limiting
# -----------------------------------------------------------------------------
RATE_LIMIT_PER_MINUTE=100
RATE_LIMIT_PER_HOUR=1000

# -----------------------------------------------------------------------------
# CORS
# -----------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
CORS_ALLOW_CREDENTIALS=true

# -----------------------------------------------------------------------------
# Development Tools
# -----------------------------------------------------------------------------
# Hot Reload
DOTNET_WATCH_RELOAD_URL_BASE=http://localhost:5000

# Code Coverage
COLLECT_COVERAGE=true
COVERLET_OUTPUT=./coverage/

# Swagger (Development only)
SWAGGER_ENABLED=true
