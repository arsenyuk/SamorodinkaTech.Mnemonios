@page
@model IndexModel
@{
    ViewData["Title"] = "Очередь стюарда";
}

<h1 class="mb-4">Очередь на обработку</h1>

@if (!Model.PendingReviews.Any())
{
    <div class="alert alert-info d-flex align-items-center" role="alert">
        <i class="bi bi-info-circle me-2"></i>
        Нет записей на обработку.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table">
            <thead>
                <tr>
                    <th class="col-id">ID</th>
                    <th class="col-person">Персона A</th>
                    <th class="col-person">Персона B</th>
                    <th>Совпавший ключ</th>
                    <th>Конфликт</th>
                    <th class="col-date">Создано</th>
                    <th class="col-actions"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var review in Model.PendingReviews)
                {
                    <tr>
                        <td><code>@review.Id.ToString()[..8]</code></td>
                        <td>
                            <a asp-page="/Review/Person" asp-route-masterId="@review.PersonAId" class="text-decoration-none">
                                <code>@review.PersonAId.ToString()[..8]</code>
                            </a>
                        </td>
                        <td>
                            <a asp-page="/Review/Person" asp-route-masterId="@review.PersonBId" class="text-decoration-none">
                                <code>@review.PersonBId.ToString()[..8]</code>
                            </a>
                        </td>
                        <td><span class="badge bg-primary badge-key">@review.SharedKeyType</span></td>
                        <td>
                            @foreach (var kt in review.ConflictKeyType.Split(',', StringSplitOptions.RemoveEmptyEntries))
                            {
                                <span class="badge bg-danger badge-key me-1">@kt</span>
                            }
                        </td>
                        <td>@ToLocalString(review.CreatedAt, "dd.MM.yyyy HH:mm")</td>
                        <td class="col-actions">
                            <a asp-page="/Review/Detail" asp-route-reviewId="@review.Id"
                               class="btn btn-outline-primary btn-sm">
                                <i class="bi bi-eye"></i> Подробнее
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <p class="text-muted mt-2" style="font-size:.85em">Всего записей: @Model.PendingReviews.Count</p>
}
