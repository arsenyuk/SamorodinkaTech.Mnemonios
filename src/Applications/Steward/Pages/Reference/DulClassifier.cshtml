@page
@model DulClassifierModel
@{
    ViewData["Title"] = "Классификатор видов ДУЛ";
}

<h1 class="mb-4"><i class="bi bi-card-list"></i> Классификатор видов ДУЛ</h1>
<p class="text-muted mb-4">Приказ ФНС от 31.08.2020 № ЕД-7-14/617@@</p>

@foreach (var (category, entries) in Model.ByCategory)
{
    <div class="card mb-4">
        <div class="card-header">
            <i class="bi bi-folder2"></i> @category
            <span class="badge bg-secondary ms-2" style="font-size:.75em">@entries.Count</span>
        </div>
        <div class="card-body p-0">
            <table class="table table-sm mb-0">
                <thead>
                    <tr><th style="width:80px">Код</th><th>Наименование документа</th></tr>
                </thead>
                <tbody>
                    @foreach (var e in entries.OrderBy(e => e.Code))
                    {
                        <tr>
                            <td><code>@e.Code</code></td>
                            <td>@e.Name</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
