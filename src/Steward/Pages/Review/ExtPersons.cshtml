@page "{personId:guid}"
@model ExtPersonsModel
@{
    ViewData["Title"] = "Staging-записи";
}

<div class="d-flex align-items-center mb-4">
    <a href="javascript:history.back()" class="btn btn-outline-secondary btn-sm me-3">
        <i class="bi bi-arrow-left"></i> Назад
    </a>
    <h1 class="mb-0">
        Staging-записи
        <code style="font-size:.7em">@Model.PersonId.ToString()[..8]</code>
    </h1>
</div>

@if (!Model.ExtPersons.Any())
{
    <div class="alert alert-info">
        <i class="bi bi-info-circle me-2"></i>
        Нет staging-записей для данной персоны.
    </div>
}
else
{
    <p class="text-muted mb-3">Всего записей: @Model.ExtPersons.Count</p>

    @foreach (var ep in Model.ExtPersons)
    {
        <div class="card mb-3">
            <div class="card-header d-flex align-items-center justify-content-between">
                <div>
                    <span class="badge bg-primary me-2">@ep.SourceSystemId</span>
                    <code>@ep.ExternalPersonId</code>
                    @if (ep.ExternalPersonType is not null)
                    {
                        <span class="badge bg-secondary ms-2">@ep.ExternalPersonType</span>
                    }
                </div>
                <div>
                    <small class="text-muted">@ToLocalString(ep.CreatedAt)</small>
                </div>
            </div>
            <div class="card-body">
                <dl class="row mb-0" style="font-size:.9em">
                    <dt class="col-sm-3">ID staging-записи</dt>
                    <dd class="col-sm-9"><code>@ep.Id</code></dd>
                    <dt class="col-sm-3">Создано</dt>
                    <dd class="col-sm-9">@ToLocalString(ep.CreatedAt)</dd>
                    <dt class="col-sm-3">Обработано</dt>
                    <dd class="col-sm-9">@(ep.ProcessedAt.HasValue ? ToLocalString(ep.ProcessedAt.Value) : "—")</dd>
                </dl>

                <hr />
                <h6 class="text-muted mb-2"><i class="bi bi-key"></i> Вычисленные HMAC-ключи</h6>
                <table class="table table-sm mb-0" style="font-size:.85em">
                    <thead>
                        <tr><th>Тип ключа</th><th>Хеш</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var (keyType, keyValue) in new[] {
                            ("inn", ep.KeyInn),
                            ("snils", ep.KeySnils),
                            ("dul", ep.KeyDul),
                            ("inn_fio", ep.KeyInnFio),
                            ("snils_fio", ep.KeySnilsFio),
                            ("dul_fio", ep.KeyDulFio)
                        })
                        {
                            if (keyValue is not null)
                            {
                                <tr>
                                    <td><code>@keyType</code></td>
                                    <td><code>@keyValue</code></td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>

                @if (ep.ExternalLinks.Any())
                {
                    <hr />
                    <h6 class="text-muted mb-2">
                        <i class="bi bi-link-45deg"></i> Внешние ссылки
                        <span class="badge bg-primary" style="font-size:.75em">@ep.ExternalLinks.Count</span>
                    </h6>
                    <table class="table table-sm mb-0" style="font-size:.85em">
                        <thead>
                            <tr><th>Система</th><th>Внешний ID</th><th>Тип</th><th>Юр. лицо</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var l in ep.ExternalLinks)
                            {
                                <tr>
                                    <td><span class="badge bg-secondary">@l.SourceSystemId</span></td>
                                    <td><code>@l.ExternalPersonId</code></td>
                                    <td>@(l.ExternalPersonType ?? "—")</td>
                                    <td>@(l.OrganizationUnitKey ?? "—")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }

                @if (ep.Defects.Any())
                {
                    <hr />
                    <h6 class="text-muted mb-2">
                        <i class="bi bi-exclamation-triangle"></i> Дефекты
                        <span class="badge bg-danger" style="font-size:.75em">@ep.Defects.Count</span>
                    </h6>
                    <table class="table table-sm mb-0" style="font-size:.85em">
                        <thead>
                            <tr><th>Тип</th><th>Описание</th><th>Поле</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var d in ep.Defects)
                            {
                                <tr>
                                    <td><code>@d.DefectType</code></td>
                                    <td>@d.DefectMessage</td>
                                    <td>@(d.FieldName ?? "—")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    }
}
