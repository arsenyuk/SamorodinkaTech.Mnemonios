@page
@model UrlMasksModel
@{
    ViewData["Title"] = "Маски URL";
}

<h1 class="mb-4"><i class="bi bi-link-45deg"></i> Маски URL для триад</h1>
<p class="text-muted mb-4">URL-шаблоны для формирования ссылок на информационные объекты во внешних системах</p>

@if (!Model.Triads.Any())
{
    <div class="alert alert-info">
        <i class="bi bi-info-circle me-2"></i>
        Нет данных о системах источниках. Дождитесь создания мастер записей.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-bordered">
            <thead>
                <tr>
                    <th>Юр. лицо</th>
                    <th>Система</th>
                    <th>Тип объекта</th>
                    <th>URL-маска</th>
                    <th>Действия</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var t in Model.Triads)
                {
                    <tr>
                        <td>@(string.IsNullOrEmpty(t.OrganizationUnitKey) ? "—" : t.OrganizationUnitKey)</td>
                        <td><span class="badge bg-primary">@t.SourceSystemId</span></td>
                        <td>@(string.IsNullOrEmpty(t.ExternalPersonType) ? "—" : t.ExternalPersonType)</td>
                        <td>
                            @if (t.HasMask)
                            {
                                <code style="font-size:.8em">@t.UrlPattern</code>
                            }
                            else
                            {
                                <span class="text-muted">Не задана</span>
                            }
                        </td>
                        <td>
                            <a asp-page="/Reference/UrlMaskEdit"
                               asp-route-organizationUnitKey="@t.OrganizationUnitKey"
                               asp-route-sourceSystemId="@t.SourceSystemId"
                               asp-route-externalPersonType="@t.ExternalPersonType"
                               class="btn btn-outline-primary btn-sm">
                                <i class="bi bi-pencil"></i>
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
